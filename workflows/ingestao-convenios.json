{
  "name": "Aula 10 - Ingestão dos convênios",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Base de convênios",
        "formDescription": "Envie os PDFs dos convênios. O envio substitui a base anterior.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Documentos",
              "fieldType": "file",
              "multipleFiles": true,
              "acceptFileTypes": ".pdf",
              "requiredField": true
            }
          ]
        },
        "options": {
          "path": "base-convenios"
        }
      },
      "id": "537b1b0b-6b1d-46f7-a510-30f75dcba727",
      "name": "Enviar convênios",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// O formulário entrega todos os PDFs num único item (Documentos_0, Documentos_1, ...).\n// Aqui cada arquivo vira um item, com o binário em \"data\" e o nome do arquivo no JSON.\nconst saida = [];\nfor (const item of $input.all()) {\n  for (const chave of Object.keys(item.binary ?? {})) {\n    const arquivo = item.binary[chave];\n    saida.push({ json: { arquivo: arquivo.fileName }, binary: { data: arquivo } });\n  }\n}\nreturn saida;"
      },
      "id": "3109dd30-8308-45ca-8489-26a756711d50",
      "name": "Um item por arquivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "id": "b58f45cb-7476-4bb8-a92a-d0943ff1e70c",
      "name": "Extrair texto",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "mode": "insert",
        "memoryKey": "convenios",
        "clearStore": true,
        "embeddingBatchSize": 50
      },
      "id": "e57c9f4c-101b-46a9-9883-5fa75e0b1484",
      "name": "Inserir na base",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "operation": "completion",
        "completionTitle": "Base atualizada",
        "completionMessage": "={{ $('Um item por arquivo').all().length }} arquivo(s) indexado(s) em {{ $input.all().length }} trecho(s).",
        "options": {}
      },
      "id": "5852d4a6-abd5-4ed2-a8ee-e2a605836afe",
      "name": "Base atualizada",
