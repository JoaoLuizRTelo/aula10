      ],
      "credentials": {
        "ollamaApi": {
          "id": "",
          "name": "Ollama"
        }
      }
    },
    {
      "parameters": {
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.text }}",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "arquivo",
                "value": "={{ $('Um item por arquivo').item.json.arquivo }}"
              },
              {
                "name": "convenio",
                "value": "={{ $json.text.match(/N[º°o]\\s*(\\d+\\/\\d{4})/)?.[1] ?? '' }}"
              }
            ]
          }
        }
      },
      "id": "f5e298ac-cd53-4969-a503-b1be5fdccf2d",
